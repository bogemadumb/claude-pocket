[Unit]
Description=Claude Pocket — backend Mini App (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/opt/claude-pocket/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/claude-pocket/pocket.env
# Один воркер принципиально: живые сессии Claude лежат в памяти процесса.
ExecStart=/opt/claude-pocket/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8030 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
